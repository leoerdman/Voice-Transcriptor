# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyd
# NOT .python-version: it is COMMITTED and is the SSOT for the interpreter
# this product is built, shipped and tested against — the same role .nvmrc
# plays for Node. desktop/scripts/prepare-runtime.sh, the CI workflow and
# desktop/python-version.js all read it, which is what stops "Python 3.12"
# from being retyped in nine places that can drift apart.
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / Frontend / Desktop
node_modules/
frontend/node_modules/
desktop/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data / logs / temp
# Legacy per-repo data directory. The app writes to the OS userData
# directory now and only reads this path when migrating an old install,
# but everything that can land here is sensitive: config.json holds
# provider API keys, .encryption_key decrypts them, api_token.txt is the
# local API credential, and recordings are the user's own audio. The
# previous list named files one by one, which is how data/.encryption_key
# and data/recordings/ ended up unignored — and how an API key reached a
# commit in the first place. Ignore the whole directory instead of chasing
# filenames.
data/
*.log
*.pid
tmp/
temp/

# Stray bundled Electron main at repo root (accidentally written by older
# build scripts). Keep out of the tree so they don't get re-committed.
/main.js
/.tmp_app_main.js

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Build artifacts
*.tgz
*.zip
*.dmg
*.app

# Bundled Python runtimes assembled by desktop/scripts/prepare-runtime.sh.
# Each subdirectory is 100-600 MB and is ONLY needed at release build time.
# Catch every runtime/<anything>/ dir (new platforms are dropped in here by
# the script), plus the download cache.
desktop/runtime/

# electron-builder intermediate output
desktop/dist/
desktop/out/
# `desktop/build/*` and not `desktop/build/`: git does not descend into an
# excluded DIRECTORY, so a negation underneath one can never match.
desktop/build/*
# ...except the DMG background, which is a committed source asset that
# package.json build.dmg.background points at. It survived only because git
# was already tracking it; a regenerated or renamed one would not have shown
# up in `git status` at all.
!desktop/build/dmg-background.png
*.exe
*.AppImage
*.blockmap
*.snap
*.deb
*.rpm

# Signature + release staging
/dist/
release/
Release/
Transcriptor-Release-*/

# Backend caches / state (in case user opens a venv in-tree)
backend/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/

# macOS metadata
**/.DS_Store
**/__MACOSX/
# Local agent state, except the committed launch configuration.
.claude/*
!.claude/launch.json
# Local agent/tool state — never part of a release checkout
.mcode/
# Per-version release staging folders (release-1.1.x/). Built
# artifacts (~600 MB each) live in dist/ and per-release folders
# during ship; never committed to git. SHA-256 in INSTALL.txt is
# the integrity contract.
release-*/

# Cowork mask weights (§6.2): the net is a file beside the app, and whether it
# ships is the owner's decision — never a `git add -A` away from a 27 MB blob.
# backend/voice_embed.py::default_model_path() reads exactly this directory.
/models/
